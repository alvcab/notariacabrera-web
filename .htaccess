RewriteEngine On

# www.notariacabrera.cl -> notariacabrera.cl (una sola dirección para Google)
RewriteCond %{HTTP_HOST} ^www\.notariacabrera\.cl$ [NC]
RewriteRule ^ https://notariacabrera.cl%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# PDF de los registros del Conservador: piden iniciar sesión (ver documento.php).
# Los archivos no están en public_html, así que si esta regla fallara darían 404, nunca quedarían abiertos.
RewriteRule ^assets/documents/(accionistas|descubrimientos|hipotecas|prohibiciones|propiedad)/([a-z0-9-]+\.pdf)$ documento.php?registro=$1&archivo=$2 [L]

# Aranceles: públicos, pero se abren por arancel.php (anota quién los abre si tiene sesión); los PDF no se abren directo
RewriteRule ^aranceles/(instrumentos-publicos|instrumentos-privados|minas)$ arancel.php?tipo=$1 [L]
RewriteRule ^assets/aranceles/ - [F]

# Remuneraciones y la Declaración de Intereses piden iniciar sesión (ver remuneraciones.php y declaracion-de-intereses.php);
# el PDF de la declaración no se abre directo
RewriteRule ^remuneraciones\.html$ remuneraciones.php [L]
RewriteRule ^declaracion-de-intereses\.html$ declaracion-de-intereses.php [L]
RewriteRule ^assets/documents/declaracion-de-intereses-2026\.pdf$ - [F]

# Las páginas se revisan siempre contra el servidor (si no cambiaron, el navegador usa su copia):
# así los cambios se ven al recargar, sin tener que forzar la recarga
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Protección del navegador: solo https, no se puede meter el sitio dentro de otra página (engaños de clic),
# no se adivinan tipos de archivo, y no se pasa la dirección completa a otros sitios
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
